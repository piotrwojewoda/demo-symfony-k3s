{% extends 'base.html.twig' %}

{% block title %}Nowa nazwa 2{% endblock %}

{% block stylesheets %}
<style>
    :root { color-scheme: dark; }
    body {
        margin: 0;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
        background: #0f172a;
        color: #e2e8f0;
        display: flex;
        min-height: 100vh;
        align-items: center;
        justify-content: center;
    }
    main { text-align: center; max-width: 640px; padding: 2rem; }
    .logo { width: 120px; height: 120px; margin-bottom: 1.5rem; }
    h1 { font-size: 2.25rem; font-weight: 300; margin: 0 0 .5rem; }
    h1 strong { font-weight: 700; }
    p.subtitle { color: #94a3b8; margin: 0 0 2rem; }
    table {
        margin: 0 auto 2rem;
        border-collapse: collapse;
        font-size: .95rem;
    }
    td {
        border: 1px solid #334155;
        padding: .5rem 1.25rem;
        text-align: left;
    }
    td:first-child { color: #94a3b8; }
    .ok { color: #4ade80; }
    .warn { color: #facc15; }
    footer { color: #64748b; font-size: .8rem; }
</style>
{% endblock %}

