{% extends 'base.html.twig' %}

{% block title %}{{ domain }}{% endblock %}

{% block stylesheets %}
<style>
    :root { color-scheme: dark; }
    body {
        margin: 0;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
        background: #0f172a;
        color: #e2e8f0;
        display: flex;
        min-height: 100vh;
        align-items: center;
        justify-content: center;
    }
    main { text-align: center; max-width: 640px; padding: 2rem; }
    .mascot { width: 260px; height: auto; margin-bottom: 1rem; }
    h1 { font-size: 3rem; font-weight: 700; margin: 0; letter-spacing: .02em; }
</style>
{% endblock %}

{% block body %}
<main>
    {% if site == 'bibop' %}
    {# bibop.pl — a weird creature #}
    <svg class="mascot" viewBox="0 0 220 175" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="A weird creature">
        <!-- antennae -->
        <path d="M95 42 Q88 18 75 12" stroke="#7c5cd6" stroke-width="5" fill="none" stroke-linecap="round"/>
        <circle cx="73" cy="10" r="6" fill="#facc15"/>
        <path d="M125 42 Q132 14 148 9" stroke="#7c5cd6" stroke-width="5" fill="none" stroke-linecap="round"/>
        <circle cx="150" cy="8" r="6" fill="#4ade80"/>
        <!-- blob body -->
        <path d="M60 62 Q45 122 80 142 Q110 157 145 142 Q180 120 165 66 Q150 32 112 34 Q75 32 60 62 Z" fill="#8b5cf6"/>
        <!-- belly -->
        <ellipse cx="112" cy="118" rx="30" ry="20" fill="#a78bfa"/>
        <!-- three eyes -->
        <circle cx="85" cy="74" r="12" fill="#ffffff"/><circle cx="85" cy="76" r="5" fill="#111827"/>
        <circle cx="140" cy="72" r="9" fill="#ffffff"/><circle cx="141" cy="73.5" r="4" fill="#111827"/>
        <circle cx="112" cy="60" r="6" fill="#ffffff"/><circle cx="112" cy="61" r="2.6" fill="#dc2626"/>
        <!-- zigzag mouth -->
        <polyline points="85,102 95,94 105,104 115,94 125,104 135,96" stroke="#1e1b29" stroke-width="4" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
        <!-- arms -->
        <path d="M62 97 Q35 92 28 72" stroke="#7c5cd6" stroke-width="8" fill="none" stroke-linecap="round"/>
        <path d="M163 97 Q192 107 198 127" stroke="#7c5cd6" stroke-width="8" fill="none" stroke-linecap="round"/>
        <!-- tentacle legs -->
        <path d="M90 148 q-6 14 -16 16" stroke="#7c5cd6" stroke-width="7" fill="none" stroke-linecap="round"/>
        <path d="M112 153 q0 12 -4 15" stroke="#7c5cd6" stroke-width="7" fill="none" stroke-linecap="round"/>
        <path d="M134 148 q8 12 18 14" stroke="#7c5cd6" stroke-width="7" fill="none" stroke-linecap="round"/>
    </svg>
    {% else %}
    {# kreciowo.pl — a little mole with a house #}
    <svg class="mascot" viewBox="0 0 220 175" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="A little mole with a house">
        <!-- house -->
        <rect x="120" y="75" width="70" height="55" fill="#e2b26b"/>
        <polygon points="110,77 155,38 200,77" fill="#b84a39"/>
        <rect x="146" y="100" width="18" height="30" rx="2" fill="#7c4a21"/>
        <circle cx="160" cy="115" r="1.6" fill="#e8d9b0"/>
        <rect x="127" y="85" width="14" height="14" fill="#9fd3e8"/>
        <line x1="134" y1="85" x2="134" y2="99" stroke="#5b7f8f" stroke-width="1.4"/>
        <line x1="127" y1="92" x2="141" y2="92" stroke="#5b7f8f" stroke-width="1.4"/>
        <!-- dirt mound -->
        <ellipse cx="55" cy="132" rx="46" ry="10" fill="#5b4632"/>
        <!-- mole body -->
        <ellipse cx="55" cy="104" rx="30" ry="26" fill="#3f3f46"/>
        <!-- head -->
        <circle cx="55" cy="80" r="18" fill="#3f3f46"/>
        <!-- snout + nose -->
        <ellipse cx="55" cy="88" rx="9" ry="6" fill="#6b6b73"/>
        <circle cx="55" cy="85" r="3" fill="#f2a0a0"/>
        <!-- eyes -->
        <circle cx="47" cy="76" r="2.6" fill="#ffffff"/><circle cx="47.6" cy="76.4" r="1.3" fill="#111827"/>
        <circle cx="63" cy="76" r="2.6" fill="#ffffff"/><circle cx="63.6" cy="76.4" r="1.3" fill="#111827"/>
        <!-- front paws -->
        <ellipse cx="29" cy="108" rx="8" ry="5" fill="#d9a0a0" transform="rotate(-20 29 108)"/>
        <ellipse cx="81" cy="108" rx="8" ry="5" fill="#d9a0a0" transform="rotate(20 81 108)"/>
    </svg>
    {% endif %}

    <h1>{{ domain }}</h1>
</main>
{% endblock %}
