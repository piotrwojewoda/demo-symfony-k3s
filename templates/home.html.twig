    <h1>Welcome to <strong>Nowa nazwa 2</strong></h1>
    <p class="subtitle">This start page is served from k3s on a Raspberry&nbsp;Pi. <strong>Deployed automatically after a GitHub merge (CI/CD proof).</strong></p>

    <table>
        <tr><td>Symfony</td><td>{{ symfony_version }}</td></tr>
        <tr><td>PHP</td><td>{{ php_version }}</td></tr>
        <tr><td>Environment</td><td>{{ environment }}</td></tr>
        <tr><td>Deployed release</td><td><code>{{ app_version }}</code></td></tr>
        <tr><td>Database</td><td class="{{ database == 'connected' ? 'ok' : 'warn' }}">{{ database }}</td></tr>
    </table>

    <footer>
        Merged on GitHub &rarr; built by Jenkins &rarr; image on ghcr.io &rarr; deployed by ArgoCD.
    </footer>
</main>
